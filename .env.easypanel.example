# Variables del servicio Docker Compose en Easypanel (pestaña de entorno, con «Create .env file» activado).
# Compose interpreta `$` en los valores: si SECRET_KEY lleva `$`, ponla ENTRE COMILLAS SIMPLES (como abajo);
# sin comillas, `$abc` se sustituye por vacío y la clave queda alterada sin avisar.

SECRET_KEY='cambia-esto-por-una-clave-larga-y-aleatoria'
ALLOWED_HOSTS=facturia.xyz,www.facturia.xyz

# --- PostgreSQL de Easypanel (servicio aparte) ---
# Host interno: el que muestra Easypanel en la pantalla de conexión del servicio Postgres.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Cloudflare R2 (jurisdicción UE) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com

# --- Extracción con Claude ---
ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-haiku-5-5
# EXTRACTION_FALLBACK_MODEL=claude-sonnet-5-5
# EXTRACTION_AUTO_APPROVE=False

# LOG_LEVEL=INFO
